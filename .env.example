DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_medee"
# openrouter.ai/settings/keys — Data API-д ямар ч хүчинтэй түлхүүр болно
OPENROUTER_API_KEY=""

# Мэдээний agent (2-р шат) — OpenRouter-ээр дуудах моделиуд
SCORE_MODEL="deepseek/deepseek-v4.1-flash"     # хямд: 1–10 үнэлгээ
WRITE_MODEL="google/gemini-3.8-flash"          # монголоор бичих
RELEVANCE_THRESHOLD=7                          # үүнээс доош бол REJECTED

# /admin хуудасны HTTP Basic нууц үг (хэрэглэгч: admin). Хоосон бол /admin 503 буцаана.
ADMIN_PASSWORD=""

# ——— Хэрэглэгчийн нэвтрэлт (Auth.js) ———
# ЗААВАЛ: session-ий түлхүүр. Үүсгэх: openssl rand -base64 32
AUTH_SECRET=""
# Сайтын үндсэн хаяг (SITE_URL-тай ижил). Localhost дээр хоосон байж болно.
AUTH_URL=""
# Google-ээр нэвтрэх (заавал биш). Хоёулаа байвал л товч харагдана.
# Redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ——— Сайтын хаяг ———
# Бүх үнэмлэхүй холбоос (canonical, og:image, RSS, FB/IG пост, имэйл) ҮҮНЭЭС гарна.
# Кодод хатуу бичсэн домэйн байхгүй — src/lib/site.ts нэг эх сурвалж.
# Төгсгөлд ташуу зураас БИЧИХГҮЙ.
SITE_URL="http://localhost:3000"
# Хуучин домэйнууд, таслалаар. Эдгээрээр ирсэн хүсэлт SITE_URL руу 301-ээр шилжинэ.
# Жишээ: "ai-medee.up.railway.app,old.ainews.mn"
OLD_HOSTS=""
# true бол Content-Security-Policy-г хатуу горимд. Анхдагчаар report-only —
# эхлээд хөтчийн консолд зөрчлүүдийг ажиглаад дараа нь асаана.
CSP_ENFORCE="false"

# Facebook хуудсанд автоматаар постлох (заавал биш)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
# Нэг pipeline run-д хэдэн пост. Pipeline өдөрт 3 удаа ажилладаг тул 1 = өдөрт 3 пост.
FB_POSTS_PER_RUN=1
# FB постын текст бичих модель. Хоосон бол WRITE_MODEL-ийг хэрэглэнэ.
FB_COPY_MODEL=""

# Instagram (заавал биш). IG_USER_ID хоосон бол IG алхам алгасагдана.
# Instagram business account id; token нь ижил FB_PAGE_ACCESS_TOKEN (instagram_content_publish эрхтэй).
# Зураггүй нийтлэл IG-д орохгүй. SITE_URL нийтэд нээлттэй байх шаардлагатай —
# Instagram-ийн сервер SITE_URL/api/fb-image/<id> хаягаар зургийг татна.
IG_USER_ID=""
# Instagram-ийн хэрэглэгчийн нэр (@-гүй) — сайтын хөлийн холбоос ба схемийн sameAs-д
IG_USERNAME=""

# FB постын зураг — OpenRouter-ийн image модель (нэг зураг ≈ $0.034)
IMAGE_MODEL="google/gemini-3.1-flash-lite-image"
# Өдөрт үүсгэх зургийн дээд тоо. 0 = зураг үүсгэхгүй (зөвхөн холбоосын preview)
FB_IMAGE_DAILY_LIMIT=5
# true бол AI зургийн оронд эх нийтлэлийн og:image-ийг картын суурь болгоно
FB_USE_SOURCE_IMAGE="false"
# true бол постын төгсгөлд «Эх сурвалж: <домэйн>» гэж нэмнэ (анхдагчаар бичихгүй)
FB_SHOW_SOURCE="false"

# Pipeline цаг бүр ажиллана (cron 0 * * * * UTC), горимоо УБ цагаар сонгоно.
# НИЙТЛЭХ горим — эдгээр цагт (УБ): бэлэн нийтлэлийг сайтад гаргаад FB-д постлоно.
PUBLISH_HOURS_UB="7,15,19"
# Өдөрт нэг удаагийн алхмууд (openrouter, arena, digest, newsletter) эндээс хойш ажиллана
DAILY_HOUR_UB=3

# БЭЛТГЭХ горим: нэг run-д хэдэн RAW үнэлэх вэ (0 = үнэлгээ унтраалттай).
# RAW дараалал 50-аас доош бол автоматаар 6 болж буурна.
AGENT_BATCH=10
# УБ өдрийн LLM зардлын дээд хэмжээ, USD (0 = хязгааргүй). Хэтэрвэл agent алхам алгасагдана.
AGENT_DAILY_BUDGET_USD=1.5
# Хэдэн нийтлэлийг урьдчилан бэлэн (текст засварласан + FB тексттэй) байлгах вэ
PREPARE_READY_TARGET=3

# Авто нийтлэх квот: УБ цагаар өдөрт хэдэн мэдээ нийтлэх вэ. 0 = унтраалттай
# (бүх нийтлэл DRAFT-д үлдэж, /admin-аас гараар нийтэлнэ). Гараар нийтэлсэн нь квотод тооцогдоно.
DAILY_PUBLISH_LIMIT=3
# Квотод нэр дэвших доод оноо — үүнээс доош оноотой нийтлэл авто нийтлэгдэхгүй
AUTO_PUBLISH_MIN_SCORE=7

# Newsletter (Resend). RESEND_API_KEY хоосон бол илгээх алхам алгасагдана.
RESEND_API_KEY=""
# Хоосон бол `AI News <noreply@<SITE_URL-ийн хост>>`
NEWSLETTER_FROM=""
NEWSLETTER_REPLY_TO=""
# Долоо хоногийн админ тайлан очих хаяг (Ням гараг). Хоосон бол илгээхгүй.
ADMIN_EMAIL=""

# Analytics — self-hosted Umami (заавал биш). Хоёул байвал л tracker ачаална.
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ——— Гүйцэтгэл ———
# Процессийн үүрэг: холболтын сангийн хэмжээг сонгоно (web 10, cron 5, script 3).
# start:web / start:cron өөрсдөө тавьдаг тул ихэвчлэн гараар бичих шаардлагагүй.
APP_ROLE=""
# Холболтын сангийн хэмжээг гараар дарах (Postgres-ийн хязгаараас хэтрүүлэхгүй)
PRISMA_POOL_MAX=""
