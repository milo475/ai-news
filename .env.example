DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_medee"
# openrouter.ai/settings/keys — Data API-д ямар ч хүчинтэй түлхүүр болно
OPENROUTER_API_KEY=""

# Мэдээний agent (2-р шат) — OpenRouter-ээр дуудах моделиуд
SCORE_MODEL="deepseek/deepseek-v4.1-flash"     # хямд: 1–10 үнэлгээ
WRITE_MODEL="google/gemini-3.8-flash"          # монголоор бичих
RELEVANCE_THRESHOLD=7                          # үүнээс доош бол REJECTED

# /admin хуудасны HTTP Basic нууц үг (хэрэглэгч: admin). Хоосон бол /admin 503 буцаана.
ADMIN_PASSWORD=""

# Facebook хуудсанд автоматаар постлох (заавал биш)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
SITE_URL="http://localhost:3000"
# Нэг pipeline run-д хэдэн пост. Pipeline өдөрт 3 удаа ажилладаг тул 1 = өдөрт 3 пост.
FB_POSTS_PER_RUN=1
# FB постын текст бичих модель. Хоосон бол WRITE_MODEL-ийг хэрэглэнэ.
FB_COPY_MODEL=""

# FB постын зураг — OpenRouter-ийн image модель (нэг зураг ≈ $0.034)
IMAGE_MODEL="google/gemini-3.1-flash-lite-image"
# Өдөрт үүсгэх зургийн дээд тоо. 0 = зураг үүсгэхгүй (зөвхөн холбоосын preview)
FB_IMAGE_DAILY_LIMIT=5
# true бол AI зургийн оронд эх нийтлэлийн og:image + «Зураг: <эх сурвалж>» credit
FB_USE_SOURCE_IMAGE="false"

# Авто нийтлэх квот: УБ цагаар өдөрт хэдэн мэдээ нийтлэх вэ. 0 = унтраалттай
# (бүх нийтлэл DRAFT-д үлдэж, /admin-аас гараар нийтэлнэ). Гараар нийтэлсэн нь квотод тооцогдоно.
DAILY_PUBLISH_LIMIT=3
# Квотод нэр дэвших доод оноо — үүнээс доош оноотой нийтлэл авто нийтлэгдэхгүй
AUTO_PUBLISH_MIN_SCORE=7

# Newsletter (Resend). RESEND_API_KEY хоосон бол илгээх алхам алгасагдана.
RESEND_API_KEY=""
NEWSLETTER_FROM="AI News <noreply@ainews.mn>"
NEWSLETTER_REPLY_TO=""

# Analytics — self-hosted Umami (заавал биш). Хоёул байвал л tracker ачаална.
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
