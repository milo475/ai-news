DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_medee"
# openrouter.ai/settings/keys — Data API-д ямар ч хүчинтэй түлхүүр болно
OPENROUTER_API_KEY=""

# Мэдээний agent (2-р шат) — OpenRouter-ээр дуудах моделиуд
SCORE_MODEL="deepseek/deepseek-v4.1-flash"     # хямд: 1–10 үнэлгээ
WRITE_MODEL="google/gemini-3.8-flash"          # монголоор бичих
RELEVANCE_THRESHOLD=7                          # үүнээс доош бол REJECTED

# /admin хуудасны HTTP Basic нууц үг (хэрэглэгч: admin). Хоосон бол /admin 503 буцаана.
ADMIN_PASSWORD=""

# Facebook хуудсанд автоматаар постлох (заавал биш)
FB_PAGE_ID=""
FB_PAGE_ACCESS_TOKEN=""
SITE_URL="http://localhost:3000"

# Авто нийтлэх: хоосон бол унтраалттай (зөвлөмж). Тоо (жишээ 9) бол тэр оноо давсан,
# бүтэн тексттэй нийтлэлийг агент шууд PUBLISHED болгоно — редактор хянахгүй.
AUTO_PUBLISH_MIN_SCORE=""

# Newsletter (Resend). RESEND_API_KEY хоосон бол илгээх алхам алгасагдана.
RESEND_API_KEY=""
NEWSLETTER_FROM="AI News <noreply@ainews.mn>"
NEWSLETTER_REPLY_TO=""

# Analytics — self-hosted Umami (заавал биш). Хоёул байвал л tracker ачаална.
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
