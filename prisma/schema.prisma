// AI мэдээний сайт — өгөгдлийн сангийн бүтэц
// Prisma 7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Жагсаалтын өгөгдөл хаанаас ирснийг заана
enum RankSource {
  OPENROUTER_USAGE   // openrouter.ai/rankings — өдөр тутмын токены хэрэглээ
  ARENA_ELO          // arena.ai — хүний саналын Elo
  AA_INTELLIGENCE    // artificialanalysis.ai — оюун чадварын индекс
}

/// Нийтлэлийн төрөл
enum ArticleKind {
  NEWS    // нэг эх сурвалжийн мэдээ
  DIGEST  // долоо хоногийн нэгтгэл
}

/// Нийтлэлийн агуулгын ангилал — зөвхөн моделийн мэдээ биш, өргөн хүрээг хамруулна
enum ArticleCategory {
  NEWS      // салбарын мэдээ
  PROJECT   // AI-аар хийсэн төсөл, бүтээгдэхүүн
  BUSINESS  // бизнес санаа, мөнгө олох жишээ
  FACT      // сонирхолтой баримт, судалгаа
  RISK      // аюул, хууран мэхлэлт, зохицуулалт
  HOWTO     // хэрэглээ, заавар
}

/// Нийтлэлийн төлөв
enum ArticleStatus {
  RAW        // эх сурвалжаас татсан, agent хараахан боловсруулаагүй
  DRAFT      // agent бэлтгэсэн, хүн шалгаагүй
  REVIEW     // хүн шалгаж байна
  PUBLISHED  // сайт дээр гарсан
  REJECTED   // agent үнэлээд хаясан
  SKIPPED    // хоцрогдсон — үнэлэлгүй алгассан (LLM дуудаагүй)
}

/// AI компани (OpenAI, Anthropic, Google ...)
model Company {
  id        String   @id @default(cuid())
  slug      String   @unique          // "openai", "anthropic"
  name      String                    // "OpenAI"
  nameMn    String?                   // "ОпенАИ" (заавал биш)
  website   String?
  country   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models   AiModel[]
  articles Article[] @relation("ArticleCompanies")
}

/// Нэг AI модель (GPT-6 Astra, Claude Fable 5.1 ...)
model AiModel {
  id             String   @id @default(cuid())
  slug           String   @unique      // OpenRouter id, URL-д хэрэглэнэ: "openai/gpt-6-astra"
  orPermaslug    String   @unique      // OpenRouter canonical_slug: "openai/gpt-6-astra-20260903" — rankings-тай тааруулна
  name           String                // "GPT-6 Astra"
  nameMn         String?               // монгол нэр/тайлбар (заавал биш)
  descriptionEn  String?               // эх сурвалжийн тайлбар
  descriptionMn  String?               // agent-ийн монгол тайлбар
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])

  isOpenWeights  Boolean  @default(false)  // нээлттэй жинтэй эсэх (HF id байвал)
  contextLength  Int?
  modality       String?                   // "text+image->text"
  releasedAt     DateTime?                 // OpenRouter-т нэмэгдсэн огноо
  /// 1 сая токены үнэ, USD
  inputPricePerM  Decimal? @db.Decimal(12, 6)
  outputPricePerM Decimal? @db.Decimal(12, 6)

  isActive   Boolean  @default(true)   // каталогоос алга болвол false
  /// Зөвхөн LMArena-д байдаг, OpenRouter-т байхгүй модель — хэрэглээний жагсаалтад орохгүй
  arenaOnly  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots RankingSnapshot[]
  articles  Article[]         @relation("ArticleModels")

  /// Хайлтын индекс — нэр + slug (компанийн угтвар slug дотор байдаг)
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([companyId])
  @@index([isActive])
  @@index([searchVector], type: Gin)
}

/// Нэг модель, нэг эх сурвалж, нэг өдрийн байр — өсөлт/уналт эндээс тооцно
model RankingSnapshot {
  id        String     @id @default(cuid())
  modelId   String
  model     AiModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  source    RankSource
  date      DateTime   @db.Date      // UTC өдөр
  rank      Int                      // 1 = хамгийн дээд
  /// Эх сурвалжийн оноо: токен (OPENROUTER), Elo (ARENA), индекс (AA)
  score     Decimal    @db.Decimal(20, 4)
  /// Өмнөх өдөртэй харьцуулсан өөрчлөлт (fetcher тооцно; эхний өдөр null)
  rankDelta  Int?                    // +2 = 2 байр дээшилсэн
  scoreDelta Decimal?   @db.Decimal(20, 4)
  createdAt DateTime   @default(now())

  @@unique([modelId, source, date])
  @@index([source, date, rank])
}

/// Мэдээний эх сурвалж (RSS)
model Source {
  id        String   @id @default(cuid())
  name      String                // "TechCrunch AI"
  url       String   @unique      // сайтын хаяг
  feedUrl   String?  @unique      // RSS/Atom хаяг
  language  String   @default("en")
  weight    Int      @default(5)  // 1–10, эх сурвалжийн найдвартай байдал
  /// Энэ эх сурвалжийн мэдээ ихэвчлэн ямар ангилалд ордог — LLM өөрөөр шийдвэл түүнийг нь авна
  defaultCategory ArticleCategory @default(NEWS)
  needsBrowser Boolean @default(false) // JS-ээр зурагддаг сайт — бүтэн текстэд Playwright хэрэгтэй
  isActive  Boolean  @default(true)
  lastFetchedAt DateTime?
  lastError     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]
}

/// Нийтлэл — эх мэдээ + agent-ийн монгол хураангуй
model Article {
  id          String          @id @default(cuid())
  slug        String          @unique        // URL: /medee/openai-gpt-6-astra-garlaa
  kind        ArticleKind     @default(NEWS)
  category    ArticleCategory @default(NEWS)  // agent үнэлэх үедээ тодорхойлно
  status      ArticleStatus   @default(DRAFT)

  // Эх сурвалжийн мэдээлэл
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id])
  sourceUrl    String   @unique             // давхардал шалгах гол түлхүүр
  sourceTitle  String
  sourceExcerpt String?                     // RSS-ийн description, HTML-гүй (≤2000 тэмдэгт)
  sourceText    String?                     // эх хуудаснаас Readability-ээр татсан бүтэн текст (≤8000)
  sourceAuthor  String?
  sourceImageUrl String?                     // эх нийтлэлийн og:image (FB_USE_SOURCE_IMAGE үед)
  sourceHash   String                       // гарчгийн normalized hash — давхардал
  publishedAtSource DateTime?

  // Agent-ийн гаргалт (монгол)
  titleMn      String?                      // RAW үед хоосон — 2-р шатанд agent бөглөнө
  summaryMn    String?                      // 1–2 өгүүлбэр (жагсаалт, FB пост)
  bodyMn       String?                      // 150–300 үгийн хураангуй, markdown
  relevance    Int      @default(0)         // 1–10, agent-ийн үнэлгээ
  tags         String[] @default([])
  scoreModel   String?                      // үнэлгээ хийсэн LLM
  writeModel   String?                      // монголоор бичсэн LLM
  scoreReason  String?                      // LLM-ийн нэг өгүүлбэр шалтгаан (англиар байж болно)
  tokensUsed   Int      @default(0)         // тухайн нийтлэлд зарцуулсан нийт токен

  // Хэвлэлт
  publishedAt  DateTime?
  fbPostId     String?                      // Facebook-т тавигдсан бол
  fbPostedAt   DateTime?                    // хэзээ постлогдсон — хоосон = дараалалд байна
  fbAttempts   Int      @default(0)         // амжилтгүй оролдлогын тоо (3 болбол алгасна)
  fbError      String?                      // сүүлийн алдааны мессеж
  /// FB-д зориулж тусдаа LLM-ээр бичүүлсэн текст (нийтлэлийн хураангуй биш)
  fbText       String?
  /// A/B туршилтын хоёр дахь хувилбар — постлогдоогүй нь
  fbTextAlt    String?
  /// Постлосон хувилбарын hook загвар: number | contrast | question | local | forecast
  fbHookType   String?
  /// FB постын зураг — 1080×1080 JPEG, DB-д (web ба cron тусдаа контейнер учир)
  fbImageData  Bytes?
  /// Зургийг үзүүлэх зам: /api/fb-image/<id>
  fbImageUrl   String?
  /// Зураг ямар аргаар гарсан: ai | source | ranking
  fbImageKind  String?
  /// Зураг үүсгэсэн огноо — өдрийн зургийн квотыг тоолоход
  fbImageAt    DateTime?
  /// AI зургийн англи prompt — /admin дээр харах, дахин үүсгэхэд
  fbImagePrompt String?
  reviewedBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models    AiModel[] @relation("ArticleModels")
  companies Company[] @relation("ArticleCompanies")

  /// Энэ нийтлэл digest бол дотор нь орсон мэдээнүүд
  digestItems DigestItem[] @relation("DigestParent")
  /// Энэ мэдээ ямар digest-үүдэд орсон бэ
  inDigests   DigestItem[] @relation("DigestChild")

  /// Хайлтын индекс — migration дотор GENERATED ALWAYS AS ... STORED
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([kind, status, publishedAt])
  @@index([status, fbPostedAt])
  @@index([status, category, publishedAt])
  @@index([searchVector], type: Gin)
  @@index([status, publishedAt])
  @@index([status, createdAt])
  @@index([sourceHash])
}

/// Fetcher/agent ажиллалтын лог — эвдэрсэн эсэхийг харах
model JobRun {
  id         String   @id @default(cuid())
  job        String                  // "openrouter", "rss", "agent"
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean?
  itemsIn    Int      @default(0)
  itemsOut   Int      @default(0)
  /// Хэдэн нэгж боловсруулахыг оролдсон, тэдгээрээс хэд нь унасан (agent: нийтлэл, rss: эх сурвалж)
  attempted  Int      @default(0)
  failed     Int      @default(0)
  error      String?
  /// Тухайн ажиллалтад OpenRouter-т төлсөн дүн (зураг, LLM) — зардлыг хөөхөд
  costUsd    Decimal? @db.Decimal(10, 6)
  pid        Int?                    // ажиллуулсан процесс — /admin-аас эхлүүлсэн үед
  logFile    String?                 // logs/<job>-<timestamp>.log

  @@index([job, startedAt])
}

/// AI хэрэгслийн үнийн бодлого
enum ToolPricing {
  FREE      // бүрэн үнэгүй
  FREEMIUM  // үнэгүй хувилбартай, төлбөртэй нь илүү
  PAID      // зөвхөн төлбөртэй
}

/// "Ямар ажилд аль AI" — ангилал. Хүн бэлтгэж, /admin-аас засна.
model UseCase {
  id            String   @id @default(cuid())
  slug          String   @unique          // URL: /hereglee/zurag
  nameMn        String
  descriptionMn String                    // 1–2 өгүүлбэр
  icon          String                    // lucide-react дүрсний нэр: "image", "code" ...
  order         Int      @default(0)      // жагсаалтын дараалал
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tools UseCaseTool[]

  /// Хайлтын индекс — нэр + тайлбар
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([isActive, order])
  @@index([searchVector], type: Gin)
}

/// Нэг AI хэрэгсэл. Олон ангилалд орж болно.
model AiTool {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  vendor           String
  url              String                        // хоосон = шалгах шаардлагатай
  descriptionMn    String                        // 1 өгүүлбэр
  pricing          ToolPricing @default(FREEMIUM)
  worksInMongolian Boolean     @default(true)
  logoUrl          String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  useCases UseCaseTool[]

  /// Хайлтын индекс — нэр + гаргагч + тайлбар
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([searchVector], type: Gin)
}

/// Ангилал ↔ хэрэгсэл, эрэмбэ ба тухайн ангилалд хамаарах тэмдэглэлтэй
model UseCaseTool {
  useCaseId String
  useCase   UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  toolId    String
  tool      AiTool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  rank      Int                              // 1 = шилдэг
  noteMn    String?                          // зөвхөн энэ ангилалд хамаарах тайлбар

  @@id([useCaseId, toolId])
  @@index([useCaseId, rank])
}

/// Digest ↔ дотор нь орсон мэдээ
model DigestItem {
  digestId  String
  digest    Article @relation("DigestParent", fields: [digestId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation("DigestChild", fields: [articleId], references: [id], onDelete: Cascade)
  order     Int

  @@id([digestId, articleId])
  @@index([digestId, order])
}

/// Жагсаалтын карт постыг өдөрт нэг л удаа тавихын тулд (нийтлэлтэй холбоогүй пост)
model FbRankingPost {
  id        String   @id @default(cuid())
  /// УБ цагийн огноо, "2026-09-23"
  day       String   @unique
  fbPostId  String?
  createdAt DateTime @default(now())
}

/// Хайлтын бүртгэл — юу хайгдаж байгааг харахад. Хувийн мэдээлэл хадгалахгүй.
model SearchLog {
  id          String   @id @default(cuid())
  q           String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Имэйл бүртгэлийн төлөв
enum SubscriberStatus {
  PENDING       // баталгаажуулах имэйл илгээсэн, хараахан дараагүй
  ACTIVE        // баталгаажсан — имэйл хүлээн авна
  UNSUBSCRIBED  // гарсан
}

/// Newsletter-ийн бүртгэл (double opt-in)
model Subscriber {
  id                String           @id @default(cuid())
  email             String           @unique
  status            SubscriberStatus @default(PENDING)
  /// Баталгаажуулах холбоосын токен — баталгаажсаны дараа null
  confirmToken      String?          @unique
  /// Бүртгэлээс гарах холбоосын токен — имэйл бүрт явна
  unsubscribeToken  String           @unique
  createdAt         DateTime         @default(now())
  confirmedAt       DateTime?

  @@index([status])
}

/// Нэг digest-ийг нэг л удаа илгээхийн тулд
model NewsletterSend {
  id              String   @id @default(cuid())
  digestArticleId String   @unique
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdAt       DateTime @default(now())
}
