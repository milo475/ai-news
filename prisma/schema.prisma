// AI мэдээний сайт — өгөгдлийн сангийн бүтэц
// Prisma 7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Жагсаалтын өгөгдөл хаанаас ирснийг заана
enum RankSource {
  OPENROUTER_USAGE // openrouter.ai/rankings — өдөр тутмын токены хэрэглээ
  ARENA_ELO // arena.ai — хүний саналын Elo
  AA_INTELLIGENCE // artificialanalysis.ai — оюун чадварын индекс
}

/// Нийтлэлийн төрөл
enum ArticleKind {
  NEWS // нэг эх сурвалжийн мэдээ
  DIGEST // долоо хоногийн нэгтгэл
}

/// Нийтлэлийн агуулгын ангилал — зөвхөн моделийн мэдээ биш, өргөн хүрээг хамруулна
enum ArticleCategory {
  NEWS // салбарын мэдээ
  PROJECT // AI-аар хийсэн төсөл, бүтээгдэхүүн
  BUSINESS // бизнес санаа, мөнгө олох жишээ
  FACT // сонирхолтой баримт, судалгаа
  RISK // аюул, хууран мэхлэлт, зохицуулалт
  HOWTO // хэрэглээ, заавар
}

/// Нийтлэлийн төлөв
enum ArticleStatus {
  RAW // эх сурвалжаас татсан, agent хараахан боловсруулаагүй
  DRAFT // agent бэлтгэсэн, хүн шалгаагүй
  REVIEW // хүн шалгаж байна
  PUBLISHED // сайт дээр гарсан
  REJECTED // agent үнэлээд хаясан
  SKIPPED // хоцрогдсон — үнэлэлгүй алгассан (LLM дуудаагүй)
}

/// AI компани (OpenAI, Anthropic, Google ...)
model Company {
  id        String   @id @default(cuid())
  slug      String   @unique // "openai", "anthropic"
  name      String // "OpenAI"
  nameMn    String? // "ОпенАИ" (заавал биш)
  website   String?
  country   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models   AiModel[]
  articles Article[] @relation("ArticleCompanies")
}

/// Нэг AI модель (GPT-6 Astra, Claude Fable 5.1 ...)
model AiModel {
  id            String  @id @default(cuid())
  slug          String  @unique // OpenRouter id, URL-д хэрэглэнэ: "openai/gpt-6-astra"
  orPermaslug   String  @unique // OpenRouter canonical_slug: "openai/gpt-6-astra-20260903" — rankings-тай тааруулна
  name          String // "GPT-6 Astra"
  nameMn        String? // монгол нэр/тайлбар (заавал биш)
  descriptionEn String? // эх сурвалжийн тайлбар
  descriptionMn String? // agent-ийн монгол тайлбар
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  isOpenWeights        Boolean   @default(false) // нээлттэй жинтэй эсэх (HF id байвал)
  contextLength        Int?
  modality             String? // "text+image->text"
  releasedAt           DateTime? // OpenRouter-т нэмэгдсэн огноо
  /// 1 сая токены үнэ, USD
  inputPricePerM       Decimal?  @db.Decimal(12, 6)
  outputPricePerM      Decimal?  @db.Decimal(12, 6)
  /// Кэшээс уншсан оролтын үнэ (pricing.input_cache_read) — их хэмжээний хэрэглээнд чухал
  cachedInputPricePerM Decimal?  @db.Decimal(12, 6)
  /// architecture.input_modalities: text, image, file, audio
  inputModalities      String[]  @default([])
  outputModalities     String[]  @default([])
  tokenizer            String?
  /// top_provider.max_completion_tokens — нэг хариуны дээд хэмжээ
  maxOutputTokens      Int?
  /// top_provider.is_moderated — provider өөрөө контентыг шүүдэг эсэх
  isModerated          Boolean?

  isActive   Boolean  @default(true) // каталогоос алга болвол false
  /// Зөвхөн LMArena-д байдаг, OpenRouter-т байхгүй модель — хэрэглээний жагсаалтад орохгүй
  arenaOnly  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots RankingSnapshot[]
  articles  Article[]         @relation("ArticleModels")

  /// Хайлтын индекс — нэр + slug (компанийн угтвар slug дотор байдаг)
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([companyId])
  @@index([isActive])
  @@index([searchVector], type: Gin)
}

/// Нэг модель, нэг эх сурвалж, нэг өдрийн байр — өсөлт/уналт эндээс тооцно
model RankingSnapshot {
  id         String     @id @default(cuid())
  modelId    String
  model      AiModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  source     RankSource
  date       DateTime   @db.Date // UTC өдөр
  rank       Int // 1 = хамгийн дээд
  /// Эх сурвалжийн оноо: токен (OPENROUTER), Elo (ARENA), индекс (AA)
  score      Decimal    @db.Decimal(20, 4)
  /// Өмнөх өдөртэй харьцуулсан өөрчлөлт (fetcher тооцно; эхний өдөр null)
  rankDelta  Int? // +2 = 2 байр дээшилсэн
  scoreDelta Decimal?   @db.Decimal(20, 4)
  createdAt  DateTime   @default(now())

  @@unique([modelId, source, date])
  @@index([source, date, rank])
}

/// Мэдээний эх сурвалж (RSS)
model Source {
  id              String          @id @default(cuid())
  name            String // "TechCrunch AI"
  url             String          @unique // сайтын хаяг
  feedUrl         String?         @unique // RSS/Atom хаяг
  language        String          @default("en")
  weight          Int             @default(5) // 1–10, эх сурвалжийн найдвартай байдал
  /// Энэ эх сурвалжийн мэдээ ихэвчлэн ямар ангилалд ордог — LLM өөрөөр шийдвэл түүнийг нь авна
  defaultCategory ArticleCategory @default(NEWS)
  needsBrowser    Boolean         @default(false) // JS-ээр зурагддаг сайт — бүтэн текстэд Playwright хэрэгтэй
  isActive        Boolean         @default(true)
  lastFetchedAt   DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  articles Article[]
}

/// Нийтлэл — эх мэдээ + agent-ийн монгол хураангуй
model Article {
  id       String          @id @default(cuid())
  slug     String          @unique // URL: /medee/openai-gpt-6-astra-garlaa
  kind     ArticleKind     @default(NEWS)
  category ArticleCategory @default(NEWS) // agent үнэлэх үедээ тодорхойлно
  status   ArticleStatus   @default(DRAFT)

  // Эх сурвалжийн мэдээлэл
  sourceId          String
  source            Source    @relation(fields: [sourceId], references: [id])
  sourceUrl         String    @unique // давхардал шалгах гол түлхүүр
  sourceTitle       String
  sourceExcerpt     String? // RSS-ийн description, HTML-гүй (≤2000 тэмдэгт)
  sourceText        String? // эх хуудаснаас Readability-ээр татсан бүтэн текст (≤8000)
  sourceAuthor      String?
  sourceImageUrl    String? // эх нийтлэлийн og:image (FB_USE_SOURCE_IMAGE үед)
  sourceHash        String // гарчгийн normalized hash — давхардал
  publishedAtSource DateTime?

  // Agent-ийн гаргалт (монгол)
  titleMn     String? // RAW үед хоосон — 2-р шатанд agent бөглөнө
  summaryMn   String? // 1–2 өгүүлбэр (жагсаалт, FB пост)
  bodyMn      String? // 150–300 үгийн хураангуй, markdown
  relevance   Int      @default(0) // 1–10, agent-ийн үнэлгээ
  tags        String[] @default([])
  scoreModel  String? // үнэлгээ хийсэн LLM
  writeModel  String? // монголоор бичсэн LLM
  scoreReason String? // LLM-ийн нэг өгүүлбэр шалтгаан (англиар байж болно)
  tokensUsed  Int      @default(0) // тухайн нийтлэлд зарцуулсан нийт токен

  // Хэвлэлт
  publishedAt   DateTime?
  fbPostId      String? // Facebook-т тавигдсан бол
  fbPostedAt    DateTime? // хэзээ постлогдсон — хоосон = дараалалд байна
  fbAttempts    Int       @default(0) // амжилтгүй оролдлогын тоо (3 болбол алгасна)
  fbError       String? // сүүлийн алдааны мессеж
  /// FB-д зориулж тусдаа LLM-ээр бичүүлсэн текст (нийтлэлийн хураангуй биш)
  fbText        String?
  /// A/B туршилтын хоёр дахь хувилбар — постлогдоогүй нь
  fbTextAlt     String?
  /// Постлосон хувилбарын hook загвар: number | contrast | question | local | forecast
  fbHookType    String?
  /// Постын карт — 1080×1350 JPEG, текст давхарласан (DB-д: web ба cron тусдаа контейнер)
  fbImageData   Bytes?
  /// Тексгүй суурь зураг — вэб нийтлэлийн hero-д (16:9 огтолно)
  heroImageData Bytes?
  /// Суурь зургийг үзүүлэх зам: /api/hero-image/<id>
  heroImageUrl  String?
  /// Карт дээр бичигдсэн headline — /admin-аас засаж, дахин үүсгэж болно
  fbHook        String?
  /// Зургийг үзүүлэх зам: /api/fb-image/<id>
  fbImageUrl    String?
  /// Зураг ямар аргаар гарсан: ai | source | ranking
  fbImageKind   String?
  /// Зураг үүсгэсэн огноо — өдрийн зургийн квотыг тоолоход
  fbImageAt     DateTime?
  /// AI зургийн англи prompt — /admin дээр харах, дахин үүсгэхэд
  fbImagePrompt String?
  // Instagram — FB-тэй ижил Page token, зураггүй нийтлэл IG-д орохгүй
  igPostedAt    DateTime?
  igMediaId     String?
  igAttempts    Int       @default(0)
  igError       String?

  /// Текстийг нэг удаа сайжруулсан огноо (БЭЛТГЭХ горим) — дахин засахгүйн тулд
  improvedAt DateTime?
  /// Нийтлэхэд бүрэн бэлэн болсон огноо: текст сайжирсан + fbText бичигдсэн
  readyAt    DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models    AiModel[] @relation("ArticleModels")
  companies Company[] @relation("ArticleCompanies")

  /// Энэ нийтлэл digest бол дотор нь орсон мэдээнүүд
  bookmarks Bookmark[]

  digestItems DigestItem[] @relation("DigestParent")
  /// Энэ мэдээ ямар digest-үүдэд орсон бэ
  inDigests   DigestItem[] @relation("DigestChild")

  /// Хайлтын индекс — migration дотор GENERATED ALWAYS AS ... STORED
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([kind, status, publishedAt])
  @@index([status, fbPostedAt])
  @@index([status, category, publishedAt])
  @@index([status, readyAt])
  @@index([status, igPostedAt])
  @@index([searchVector], type: Gin)
  @@index([status, publishedAt])
  @@index([status, createdAt])
  @@index([sourceHash])
}

/// Fetcher/agent ажиллалтын лог — эвдэрсэн эсэхийг харах
model JobRun {
  id         String    @id @default(cuid())
  job        String // "openrouter", "rss", "agent", "pipeline"
  /// Аль горимын run бэ: PUBLISH (нийтлэх) | PREPARE (бэлтгэх)
  mode       String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  itemsIn    Int       @default(0)
  itemsOut   Int       @default(0)
  /// Хэдэн нэгж боловсруулахыг оролдсон, тэдгээрээс хэд нь унасан (agent: нийтлэл, rss: эх сурвалж)
  attempted  Int       @default(0)
  failed     Int       @default(0)
  error      String?
  /// Тухайн ажиллалтад OpenRouter-т төлсөн дүн (зураг, LLM) — зардлыг хөөхөд
  costUsd    Decimal?  @db.Decimal(10, 6)
  pid        Int? // ажиллуулсан процесс — /admin-аас эхлүүлсэн үед
  logFile    String? // logs/<job>-<timestamp>.log

  @@index([job, startedAt])
}

/// AI хэрэгслийн үнийн бодлого
enum ToolPricing {
  FREE // бүрэн үнэгүй
  FREEMIUM // үнэгүй хувилбартай, төлбөртэй нь илүү
  PAID // зөвхөн төлбөртэй
}

/// "Ямар ажилд аль AI" — ангилал. Хүн бэлтгэж, /admin-аас засна.
model UseCase {
  id            String   @id @default(cuid())
  slug          String   @unique // URL: /hereglee/zurag
  nameMn        String
  descriptionMn String // 1–2 өгүүлбэр
  icon          String // lucide-react дүрсний нэр: "image", "code" ...
  order         Int      @default(0) // жагсаалтын дараалал
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tools UseCaseTool[]

  /// Хайлтын индекс — нэр + тайлбар
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([isActive, order])
  @@index([searchVector], type: Gin)
}

/// Нэг AI хэрэгсэл. Олон ангилалд орж болно.
model AiTool {
  id               String      @id @default(cuid())
  slug             String      @unique
  name             String
  vendor           String
  url              String // хоосон = шалгах шаардлагатай
  descriptionMn    String // 1 өгүүлбэр
  pricing          ToolPricing @default(FREEMIUM)
  worksInMongolian Boolean     @default(true)
  logoUrl          String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  useCases UseCaseTool[]

  /// Хайлтын индекс — нэр + гаргагч + тайлбар
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([searchVector], type: Gin)
}

/// Ангилал ↔ хэрэгсэл, эрэмбэ ба тухайн ангилалд хамаарах тэмдэглэлтэй
model UseCaseTool {
  useCaseId String
  useCase   UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  toolId    String
  tool      AiTool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  rank      Int // 1 = шилдэг
  noteMn    String? // зөвхөн энэ ангилалд хамаарах тайлбар

  @@id([useCaseId, toolId])
  @@index([useCaseId, rank])
}

/// Digest ↔ дотор нь орсон мэдээ
model DigestItem {
  digestId  String
  digest    Article @relation("DigestParent", fields: [digestId], references: [id], onDelete: Cascade)
  articleId String
  article   Article @relation("DigestChild", fields: [articleId], references: [id], onDelete: Cascade)
  order     Int

  @@id([digestId, articleId])
  @@index([digestId, order])
}

/// Жагсаалтын карт постыг өдөрт нэг л удаа тавихын тулд (нийтлэлтэй холбоогүй пост)
model FbRankingPost {
  id        String   @id @default(cuid())
  /// УБ цагийн огноо, "2026-09-23"
  day       String   @unique
  fbPostId  String?
  createdAt DateTime @default(now())
}

/// Хайлтын бүртгэл — юу хайгдаж байгааг харахад. Хувийн мэдээлэл хадгалахгүй.
model SearchLog {
  id          String   @id @default(cuid())
  q           String
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Хэрэглэгчийн эрх
enum UserRole {
  USER
  ADMIN
}

/// Сайтын хэрэглэгч (Auth.js). Нууц үгээр эсвэл Google-ээр нэвтэрнэ.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// bcrypt hash — зөвхөн нууц үгээр бүртгүүлсэн хэрэглэгчид
  passwordHash    String?
  image           String?
  role            UserRole  @default(USER)
  /// Имэйл баталгаажсан огноо — бичих үйлдэлд шаардана (requireVerified)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Бүх төхөөрөмжөөс гарахад нэмэгдэнэ — хуучин JWT хүчингүй болно
  sessionVersion Int @default(0)

  accounts      Account[]
  sessions      Session[]
  /// Ижил имэйлтэй newsletter бүртгэл байвал холбогдоно
  subscriber    Subscriber?
  bookmarks     Bookmark[]
  preference    UserPreference?
  guides        Guide[]
  prompts       Prompt[]
  promptLikes   PromptLike[]
  promptReports PromptReport[]
  tools         Tool[]
  toolReviews   ToolReview[]
  toolUpvotes   ToolUpvote[]

  @@index([role])
}

/// Хэрэглэгчийн хадгалсан нийтлэл
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  /// articleId, guideId, promptId, toolId — яг нэг нь бөглөгдөнө (DB-д CHECK constraint)
  articleId String?
  guideId   String?
  promptId  String?
  toolId    String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  guide   Guide?   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  prompt  Prompt?  @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tool    Tool?    @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([userId, guideId])
  @@unique([userId, promptId])
  @@unique([userId, toolId])
  @@index([userId, createdAt])
  @@index([articleId])
  @@index([guideId])
  @@index([promptId])
  @@index([toolId])
}

/// Монгол хэлний prompt-уудын сан — /prompt
model Prompt {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  /// Prompt-ын бүтэн текст. {хувьсагч} хэлбэрээр хоосон нүх тавина
  body         String
  /// Юунд зориулсан бэ — ≤200 тэмдэгт
  description  String
  category     PromptCategory @default(BUSAD)
  /// Аль хэрэгсэлд тохирох: ChatGPT, Gemini, Claude ...
  tools        String[]       @default([])
  language     PromptLanguage @default(MN)
  /// body доторх {хувьсагч}-уудын нэр, бичигдсэн дарааллаар
  variables    String[]       @default([])
  /// Хэрэглэгч нэмсэн бол — хэн нэмсэн
  authorUserId String?
  author       User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  source       PromptSource   @default(USER)
  status       PromptStatus   @default(PENDING)
  /// Хэдэн удаа хуулсан / таалагдсан
  copies       Int            @default(0)
  likes        Int            @default(0)
  /// Seed-ийн давхардал шалгах захиалсан сэдэв (Guide.topic-той ижил зарчим)
  topic        String?
  /// Автомат шалгалт татгалзсан бол шалтгаан
  rejectReason String?
  createdAt    DateTime       @default(now())
  publishedAt  DateTime?
  updatedAt    DateTime       @updatedAt

  likedBy      PromptLike[]
  reports      PromptReport[]
  bookmarks    Bookmark[]
  /// Каталогийн хэрэгслүүдтэй холбоос (tools нь нэрсийн массив тул өөр нэр)
  catalogTools Tool[]         @relation("PromptTools")

  /// Хайлтын индекс — гарчиг A, тайлбар B, бие C
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([status, publishedAt])
  @@index([category])
  @@index([authorUserId, createdAt])
  @@index([topic])
  @@index([searchVector], type: Gin)
}

model PromptLike {
  userId    String
  promptId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@id([userId, promptId])
  @@index([promptId])
}

model PromptReport {
  id        String   @id @default(cuid())
  userId    String
  promptId  String
  reason    String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([promptId])
  @@index([userId])
}

enum PromptCategory {
  AJIL
  SURGALT
  BIZNES
  BICHIH
  CODE
  ZURAG
  ORCHUULGA
  AMIDRAL
  BUSAD
}

enum PromptLanguage {
  MN
  EN
  MIXED
}

enum PromptSource {
  SITE
  USER
}

enum PromptStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// Мөнхийн (evergreen) гарын авлага — /zaavar
model Guide {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  /// 2 өгүүлбэрийн танилцуулга — жагсаалтын карт, meta description
  lead            String
  /// Markdown. ## = алхам, ```prompt хашилт = хуулж болох prompt
  bodyMd          String
  level           GuideLevel  @default(BEGINNER)
  /// Хэнд зориулсан: оюутан, ажилтан, бизнес эрхлэгч, багш, эцэг эх
  audience        String[]    @default([])
  /// Дурдагдсан хэрэгслүүд: ChatGPT, Gemini, Canva ...
  tools           String[]    @default([])
  /// /hereglee-ийн ангилалтай холбоно
  usecaseSlug     String?
  readMinutes     Int         @default(5)
  /// Тексгүй суурь зураг — card.ts-ийн scene урсгалаар
  heroImageData   Bytes?
  heroImagePrompt String?
  heroImageAt     DateTime?
  /// [{ q, a }] — FAQ accordion + JSON-LD FAQPage
  faq             Json        @default("[]")
  status          GuideStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  views           Int         @default(0)
  /// Ямар сэдвээр захиалсан бэ — seed давхардахгүй байх, админд харагдах
  topic           String?
  /// Хэн үүсгэсэн (админ). LLM бичсэн бол хоосон
  authorUserId    String?
  author          User?       @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  /// Бичүүлэхэд зарцуулсан LLM-ийн зардал
  costUsd         Float       @default(0)

  bookmarks    Bookmark[]
  /// Каталогийн хэрэгслүүдтэй холбоос (tools нь нэрсийн массив тул өөр нэр)
  catalogTools Tool[]     @relation("GuideTools")

  /// Хайлтын индекс — гарчиг A, lead B, бие C
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([status, publishedAt])
  @@index([level])
  @@index([usecaseSlug])
  @@index([topic])
  @@index([searchVector], type: Gin)
}

enum GuideLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum GuideStatus {
  DRAFT
  PUBLISHED
}

/// Хэрэглэгчийн сонирхол — нүүр хуудасны хувийн блок, имэйлийн тохиргоо
model UserPreference {
  id          String            @id @default(cuid())
  userId      String            @unique
  /// Сонирхдог ангиллууд (хоосон = бүгд)
  categories  ArticleCategory[] @default([])
  /// /hereglee-ийн ангиллын slug-ууд
  usecases    String[]          @default([])
  /// Долоо хоногийн тоймыг имэйлээр авах эсэх
  digestEmail Boolean           @default(true)
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Auth.js — OAuth бүртгэл (Google ...)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js — session (JWT хэрэглэж байгаа ч adapter-т шаардлагатай)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Имэйл баталгаажуулах, нууц үг сэргээх токенууд
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Имэйл бүртгэлийн төлөв
enum SubscriberStatus {
  PENDING // баталгаажуулах имэйл илгээсэн, хараахан дараагүй
  ACTIVE // баталгаажсан — имэйл хүлээн авна
  UNSUBSCRIBED // гарсан
}

/// Newsletter-ийн бүртгэл (double opt-in)
model Subscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  /// Ижил имэйлтэй хэрэглэгч бүртгүүлбэл холбогдоно
  userId           String?          @unique
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status           SubscriberStatus @default(PENDING)
  /// Баталгаажуулах холбоосын токен — баталгаажсаны дараа null
  confirmToken     String?          @unique
  /// Бүртгэлээс гарах холбоосын токен — имэйл бүрт явна
  unsubscribeToken String           @unique
  createdAt        DateTime         @default(now())
  confirmedAt      DateTime?

  @@index([status])
}

/// Нэг digest-ийг нэг л удаа илгээхийн тулд
model NewsletterSend {
  id              String   @id @default(cuid())
  digestArticleId String   @unique
  sentCount       Int      @default(0)
  failedCount     Int      @default(0)
  createdAt       DateTime @default(now())
}

/// —————————————————— Монгол хэлний бенчмарк (/benchmark) ——————————————————

/// Нэг даалгавар. Нийтэд харуулахгүй (contamination) — зөвхөн isPublic=true нь нээлттэй.
model BenchTask {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  category  BenchCategory
  /// Моделд өгөх даалгавар
  prompt    String
  /// Лавлах хариулт — шүүгчид өгнө. Seed дээр LLM бичээд админ засна.
  reference String?
  /// 3–4 шалгуур: [{ name, weight, hint }]
  rubric    Json          @default("[]")
  /// Тодорхой шалгалт: { kind: "json" | "maxWords" | "cyrillic", limit?, minRatio? }
  checker   Json?
  weight    Int           @default(1)
  isActive  Boolean       @default(true)
  /// Нээлттэй жишээ даалгавар — /benchmark дээр харагдана
  isPublic  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  results BenchResult[]

  @@index([isActive, category])
}

/// Сар бүрийн нэг ажиллагаа
model BenchRun {
  id          String      @id @default(cuid())
  /// "2026-10" — сар бүр нэг
  month       String      @unique
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  judgeModel  String
  judgeModel2 String?
  costUsd     Float       @default(0)
  status      BenchStatus @default(RUNNING)
  /// Төсөв хэтэрсэн, алдаа гарсан тухай тэмдэглэл
  note        String?
  /// Автоматаар үүсгэсэн DRAFT нийтлэл
  articleId   String?

  results   BenchResult[]
  summaries BenchModelSummary[]

  @@index([status, startedAt])
}

model BenchResult {
  id        String    @id @default(cuid())
  runId     String
  run       BenchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// OpenRouter-ийн модель id ("openai/gpt-6")
  modelSlug String
  taskId    String
  task      BenchTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  output      String
  latencyMs   Int    @default(0)
  tokensIn    Int    @default(0)
  tokensOut   Int    @default(0)
  costUsd     Float  @default(0)
  /// Моделийн гаргасан монгол үгийн тоо — 1000 үгийн үнэ тооцоход
  outputWords Int    @default(0)

  /// 0–10. Хоёр шүүгчтэй бол дундаж.
  judgeScore  Float?
  judgeNotes  String?
  /// Хоёр дахь шүүгчийн оноо (шүүгч өөрийгөө шүүхээс сэргийлэх)
  judgeScore2 Float?
  /// Тодорхой шалгалтын үр дүн. false = оноо 0.
  checkerPass Boolean?
  /// Админ гараар өгсөн оноо — байвал judgeScore-ийг дарна
  humanScore  Float?
  humanNote   String?
  /// Модель хариу өгөөгүй (timeout, алдаа)
  error       String?
  createdAt   DateTime @default(now())

  @@unique([runId, modelSlug, taskId])
  @@index([runId, modelSlug])
  @@index([taskId])
}

model BenchModelSummary {
  id              String   @id @default(cuid())
  runId           String
  run             BenchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  modelSlug       String
  /// 0–10, жигнэсэн дундаж
  avgScore        Float
  /// { ORCHUULGA_MN_EN: 8.3, ... }
  scoreByCategory Json     @default("{}")
  avgLatency      Int      @default(0)
  /// Монгол 1000 үг гаргахад USD
  costPer1kMn     Float    @default(0)
  /// Хэдэн даалгавар амжилттай дууссан
  completed       Int      @default(0)
  rank            Int

  @@unique([runId, modelSlug])
  @@index([runId, rank])
}

enum BenchCategory {
  ORCHUULGA_MN_EN
  ORCHUULGA_EN_MN
  TOVCHLOL
  NAIRUULGA
  ALBAN_BICHIG
  OILGOLT
  BODLOGO
  SOYOL
  ZAAVAR_DAGAH
  JSON_GARGAH
}

enum BenchStatus {
  RUNNING
  DONE
  FAILED
  BUDGET
}

/// —————————————————— AI хэрэгслийн каталог (/hereglel) ——————————————————

/// Нэг хэрэгсэл. `AiTool` нь /hereglee-ийн хуучин жижиг жагсаалт — энэ нь бүрэн каталог.
model Tool {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  /// Нэг мөрийн тайлбар, ≤80 тэмдэгт
  tagline           String
  descriptionMd     String
  website           String
  /// 64×64 favicon (PNG/SVG). Олдохгүй бол үсгэн avatar зурна.
  logoData          Bytes?
  logoType          String?
  logoAt            DateTime?
  categories        ToolCategory[]   @default([])
  pricing           ToolPlan         @default(FREEMIUM)
  /// USD/сар, хамгийн хямд төлбөртэй хувилбар
  priceFrom         Float?
  mongolianSupport  MongolianSupport @default(PARTIAL)
  /// web / ios / android / desktop / api
  platforms         String[]         @default([])
  /// Монгол хэрэглэгчид анхаарах зүйлс (LLM бичнэ, админ засна)
  mnNoteMd          String?
  affiliateUrl      String?
  /// Хэрэглэгчийн шүүмжийн дундаж, 1–5
  rating            Float            @default(0)
  reviewCount       Int              @default(0)
  upvotes           Int              @default(0)
  status            ToolStatus       @default(PENDING)
  source            ToolSource       @default(USER)
  submittedByUserId String?
  submittedBy       User?            @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  /// Seed давхардлаас хамгаалах захиалсан нэр
  topic             String?
  rejectReason      String?
  createdAt         DateTime         @default(now())
  publishedAt       DateTime?
  updatedAt         DateTime         @updatedAt

  /// Хувилбарууд — хоёр тал нь бие биеэ заана
  alternativesTo Tool[] @relation("ToolAlternatives")
  alternativeOf  Tool[] @relation("ToolAlternatives")

  relatedGuides  Guide[]  @relation("GuideTools")
  relatedPrompts Prompt[] @relation("PromptTools")

  reviews   ToolReview[]
  clicks    ToolClick[]
  upvotedBy ToolUpvote[]
  bookmarks Bookmark[]

  /// Хайлтын индекс — нэр A, tagline B, тайлбар C
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@index([status, publishedAt])
  @@index([status, upvotes])
  @@index([pricing])
  @@index([mongolianSupport])
  @@index([topic])
  @@index([searchVector], type: Gin)
}

model ToolReview {
  id           String     @id @default(cuid())
  toolId       String
  tool         Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1–5
  stars        Int
  /// ≤500 тэмдэгт
  text         String?
  status       ToolStatus @default(PENDING)
  rejectReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Нэг хэрэглэгч нэг хэрэгсэлд нэг шүүмж
  @@unique([toolId, userId])
  @@index([toolId, status])
  @@index([userId])
}

/// Upvote — нэг хэрэглэгч нэг хэрэгсэлд нэг удаа (upvotes багана үүнээс тоологдоно)
model ToolUpvote {
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([userId, toolId])
  @@index([toolId])
}

/// Вэбсайт/affiliate товшилт — өдрөөр нэгтгэнэ
model ToolClick {
  id     String @id @default(cuid())
  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  /// УБ цагийн огноо, "2026-09-26"
  day    String
  count  Int    @default(0)

  @@unique([toolId, day])
  @@index([day])
}

enum ToolCategory {
  CHAT
  BICHIH
  ZURAG
  VIDEO
  AUDIO
  CODE
  OFFICE
  SURGALT
  MARKETING
  BIZNES
  ORCHUULGA
  HAILT
  AGENT
  BUSAD
}

/// AiTool-ийн ToolPricing-ээс тусдаа — TRIAL нэмэгдсэн
enum ToolPlan {
  FREE
  FREEMIUM
  PAID
  TRIAL
}

enum MongolianSupport {
  NONE
  PARTIAL
  GOOD
}

enum ToolStatus {
  PENDING
  PUBLISHED
}

enum ToolSource {
  SITE
  USER
}

/// —————————————————— Моделийн харьцуулалт (/harits) ——————————————————

/// Хоёр моделийн харьцуулалтын LLM дүгнэлтийн кэш. Хуудас бүрд нэг мөр.
model AiModelComparison {
  id          String    @id @default(cuid())
  /// "<slugA>--vs--<slugB>", slug-ийн "/" нь "~" болсон, цагаан толгойн эрэмбэтэй
  pairKey     String    @unique
  /// 3 өгүүлбэрийн дүгнэлт. Хоосон = хараахан үүсгээгүй.
  summaryMn   String?
  /// Дүгнэлт хэзээ бичигдсэн — 30 хоног хуучирвал дахин бичүүлнэ
  generatedAt DateTime?
  /// LLM-ийн зардал
  costUsd     Float     @default(0)
  /// Хэдэн удаа үзсэн — /harits дээр «хамгийн их үзэгдсэн» жагсаалтад
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([views])
  @@index([generatedAt])
}
